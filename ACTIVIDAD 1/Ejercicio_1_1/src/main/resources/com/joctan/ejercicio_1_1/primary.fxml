<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joctan.ejercicio_1_1.PrimaryController">
   <children>
      <Label text="Fecha de Nacimiento" />
      <HBox prefHeight="42.0" prefWidth="341.0">
         <children>
            <Label prefHeight="18.0" prefWidth="127.0" text="Fecha de Nacimiento" />
            <TextField fx:id="caja" prefHeight="26.0" prefWidth="130.0" promptText="dd/mm/aaaa" />
         </children>
      </HBox>
      <HBox prefHeight="0.0" prefWidth="200.0">
         <children>
            <Button fx:id="calcular" mnemonicParsing="false" onAction="#calcular" text="Calcular" />
            <Button fx:id="limpiar" mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
         </children>
      </HBox>
      <VBox prefHeight="0.0" prefWidth="200.0">
         <children>
            <Label fx:id="MostrarEdad" prefHeight="18.0" prefWidth="199.0" text="Tu edad" />
         </children>
      </VBox>
   </children>
   
   
   
   
   
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
