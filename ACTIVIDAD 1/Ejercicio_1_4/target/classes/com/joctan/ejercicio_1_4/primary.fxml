<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joctan.ejercicio_1_4.PrimaryController">
   <children>
      <HBox prefHeight="1.0" prefWidth="200.0">
         <children>
            <Label prefHeight="18.0" prefWidth="62.0" text="Tabla del:" />
            <Button mnemonicParsing="false" onAction="#calcular" text="Calcular" />
         </children>
      </HBox>
      <HBox prefHeight="0.0" prefWidth="200.0">
         <children>
            <TextField fx:id="caja" prefHeight="25.0" prefWidth="58.0" />
            <Button mnemonicParsing="false" onAction="#borrar" text="Limpiar" />
         </children>
      </HBox>
      <ListView fx:id="lista" prefHeight="313.0" prefWidth="200.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
